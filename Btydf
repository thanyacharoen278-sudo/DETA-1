end

local function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetLevel()
    local n = 0
    pcall(function()
        n = LP.Data.Level.Value
    end)
    if n == 0 then
        pcall(function()
            n = LP.PlayerStats.lvl.Value
        end)
    end
    return n or 0
end

local function CancelTween(tw)
    pcall(function()
        if tw then
            tw:Cancel()
        end
    end)
end

local function AutoHaki()
    if not _G.AutoHaki then
        return
    end
    pcall(function()
        local c = Char()
        if c and not c:FindFirstChild("HasBuso") then
            RS.Remotes.CommF_:InvokeServer("Buso")
        end
    end)
end

local function EquipTool(name)
    if not name or name == "" then
        return
    end
    pcall(function()
        local c, h = Char(), Hum()
        if not c or not h then
            return
        end
        local held = c:FindFirstChildOfClass("Tool")
        if held and held.Name == name then
            return
        end
        h:UnequipTools()
        local bag = LP:FindFirstChild("Backpack")
        local t = (bag and bag:FindFirstChild(name)) or c:FindFirstChild(name)
        if t and t:IsA("Tool") then
            h:EquipTool(t)
        end
    end)
end

local function RefreshWeapon()
    pcall(function()
        local bag = LP:FindFirstChild("Backpack")
        local c = Char()
        local function scan(parent, tip)
            if not parent then
                return nil
            end
            for _, t in ipairs(parent:GetChildren()) do
                if t:IsA("Tool") then
                    local tt = ""
                    pcall(function()
                        tt = tostring(t.ToolTip or "")
                    end)
                    if tip == "Melee" and (tt == "Melee" or t.Name == "Combat") then
                        return t.Name
                    end
                    if tip == "Sword" and tt == "Sword" then
                        return t.Name
                    end
                    if (tip == "Blox Fruit" or tip == "Blox Fruits") and (tt == "Blox Fruit" or tt == "Fruit") then
                        return t.Name
                    end
                end
            end
            return nil
        end
        local n = scan(c, ChooseWeapon) or scan(bag, ChooseWeapon)
        if n then
            SelectWeapon = n
        elseif ChooseWeapon == "Melee" then
            SelectWeapon = "Combat"
        end
    end)
end

local function LoadCombat()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts")
        if ps and ps:FindFirstChild("CombatFramework") then
            AC = require(ps.CombatFramework)
            return
        end
    end)
    pcall(function()
        for _, v in pairs(getreg()) do
            if type(v) == "table" and rawget(v, "activeController") then
                AC = v
                break
            end
        end
    end)
end

-- M1 เร็ว · ไม่คลิกจอ · ตัดอนิเมะเท่าที่ controller ทำได้
local function AttackNoCoolDown()
    pcall(function()
        if not AC then
            LoadCombat()
        end
        local c = AC and AC.activeController
        if c then
            c.timeToNextAttack = 0
            c.attacking = false
            c.blocking = false
            c.hitboxMagnitude = HITBOX
            if type(c.increment) == "number" then
                c.increment = 99
            end
            if type(c.focusStart) == "number" then
                c.focusStart = 0
            end
            if type(c.currentAttackTrack) \~= "nil" then
                pcall(function()
                    if c.currentAttackTrack then
                        c.currentAttackTrack:Stop()
                    end
                    c.currentAttackTrack = nil
                end)
            end
            if type(c.attack) == "function" then
                c:attack()
            end
        end
    end)
    pcall(function()
        local tool = Char() and Char():FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end)
end

local function NoShake()
