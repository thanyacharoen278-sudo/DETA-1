local function TweenTo(cf)
    local h = HRP()
    if not h or not cf then
        return
    end
    CancelTween(moveTween)
    CancelTween(floatTween)
    pcall(function()
        local dist = (h.Position - cf.Position).Magnitude
        if dist < 4 then
            h.CFrame = cf
            return
        end
        local t = math.clamp(dist / TWEEN_SPEED, 0.12, 5)
        moveTween = TweenService:Create(
            h,
            TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            { CFrame = cf }
        )
        moveTween:Play()
        moveTween.Completed:Wait()
    end)
    pcall(function()
        local h2 = HRP()
        if h2 then
            h2.AssemblyLinearVelocity = Vector3.zero
            h2.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function FloatOn(mob)
    local h = HRP()
    local eh = mob and mob:FindFirstChild("HumanoidRootPart")
    if not h or not eh then
        return
    end

    local goalPos = eh.Position + Vector3.new(0, FLOAT_HEIGHT, 0)
    local goalCF = CFrame.lookAt(goalPos, eh.Position + Vector3.new(0, 0.4, 0))
    local dist = (h.Position - goalPos).Magnitude

    local hu = Hum()
    if hu then
        hu.WalkSpeed = 0
        hu.JumpPower = 0
        hu.AutoRotate = false
    end

    if dist > 90 then
        TweenTo(goalCF)
        return
    end

    if dist < 1.2 then
        h.CFrame = goalCF
        pcall(function()
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end)
        return
    end

    CancelTween(floatTween)
    local t = math.clamp(dist / 80, 0.08, FLOAT_TWEEN_TIME)
    floatTween = TweenService:Create(
        h,
        TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = goalCF }
    )
    floatTween:Play()
    pcall(function()
        h.AssemblyLinearVelocity = Vector3.zero
        h.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function ExpandHitbox(mob)
    pcall(function()
        local r = mob:FindFirstChild("HumanoidRootPart")
        if r then
            r.Size = Vector3.new(60, 60, 60)
            r.Transparency = 1
            r.CanCollide = false
        end
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.JumpPower = 0
            hum.WalkSpeed = 0
        end
    end)
end

