-- REMOTE
-------------------------------------------------
local Net = RS:WaitForChild("Modules"):WaitForChild("Net")
local RegisterAttack = Net["RE/RegisterAttack"]
local RegisterHit = Net["RE/RegisterHit"]

-------------------------------------------------
-- HELPERS
-------------------------------------------------
local function Char(p)
    return (p or LP).Character
end

local function HRP(p)
    local c = Char(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function IsAlive(model)
    local h = model and model:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function HoldingTool()
    local c = Char()
    return c and c:FindFirstChildOfClass("Tool")
end

local function GetHitPart(model)
    return model:FindFirstChild("LeftLowerArm")
        or model:FindFirstChild("LeftUpperArm")
        or model:FindFirstChild("RightLowerArm")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("HumanoidRootPart")
end

local function FindPlayer(name)
    if not name or name == "" then return nil end
    name = string.lower(name:gsub("^%s*(.-)%s*$", "%1"))
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == name or string.lower(p.DisplayName) == name then
            return p
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), name, 1, true) then
            return p
        end
    end
    return nil
end

-------------------------------------------------
-- TARGETS
-------------------------------------------------
local function GetTargets()
    local h = HRP()
    if not h then return {} end
    local pos = h.Position
    local list = {}

    -- มอน
    local folder = workspace:FindFirstChild("Enemies")
    if folder then
        for _, mob in ipairs(folder:GetChildren()) do
            if IsAlive(mob) then
                local root = mob:FindFirstChild("HumanoidRootPart")
                local part = GetHitPart(mob)
                if root and part and (root.Position - pos).Magnitude <= RANGE then
                    table.insert(list, { part = part, model = mob, name = mob.Name })
                end
            end
        end
    end

    -- ผู้เล่น (PVP)
    if Settings.AttackPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr \~= LP then
                local c = Char(plr)
                if c and IsAlive(c) then
                    local root = HRP(plr)
                    local part = GetHitPart(c)
                    if root and part and (root.Position - pos).Magnitude <= RANGE then
                        table.insert(list, { part = part, model = c, name = plr.Name })
                    end
                end
            end
        end
    end

    return list
end

-------------------------------------------------
-- ATTACK (เฉพาะตอนถืออาวุธ)
-------------------------------------------------
local function DoAttack(targets)
    if not HoldingTool() then return end
    if not RegisterAttack or not RegisterHit then return end
    if #targets == 0 then return end

    for _, t in ipairs(targets) do
        if not HoldingTool() then return end
        if t.model and t.model.Parent and IsAlive(t.model) then
            pcall(function()
                RegisterAttack:FireServer(-math.huge)
                RegisterHit:FireServer(t.part, {})
            end)
            task.wait(Settings.FastAttack and FAST_DELAY or DELAY)
        end
    end
end

-------------------------------------------------
-- GATHER
-------------------------------------------------
local function GatherMobs()
    local h = HRP()
    if not h then return end
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return end

    local i = 0
    for _, mob in ipairs(folder:GetChildren()) do
        if IsAlive(mob) then
            local root = mob:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - h.Position).Magnitude <= GATHER_RANGE then
                i = i + 1
                local a = (i / 12) * math.pi * 2
                pcall(function()
                    root.CFrame = CFrame.new(h.Position + Vector3.new(math.cos(a) * GATHER_DIST, 0, math.sin(a) * GATHER_DIST))
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end
end

-------------------------------------------------
-- AIM LOCK
-------------------------------------------------
RunService.RenderStepped:Connect(function()
    if not Settings.AimLock then return end
    local target = FindPlayer(Settings.AimName)
    if not target or target == LP then return end
    local root = HRP(target)
    local cam = workspace.CurrentCamera
    if not root or not cam or not IsAlive(Char(target)) then return end
    pcall(function()
        cam.CFrame = CFrame.lookAt(cam.CFrame.Position, root.Position)
    end)
end)

